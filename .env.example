# Local-development convenience only. Environment variables override these values.
DOXARY_APP_ENV=development
DOXARY_DATABASE_URL=
DOXARY_AI_ENABLED=false
DOXARY_OPENAI_API_KEY=
DOXARY_AI_MODEL=gpt-4o-mini
DOXARY_AI_REASONING_EFFORT=medium
DOXARY_AI_TIMEOUT_SECONDS=60
DOXARY_TEMPORARY_INPUT_ROOT=.doxary-tmp
DOXARY_WORKER_POLL_INTERVAL_SECONDS=2
DOXARY_WORKER_LEASE_SECONDS=300
DOXARY_WORKER_MAX_ATTEMPTS=3
DOXARY_WORKER_RETRY_DELAY_SECONDS=5
